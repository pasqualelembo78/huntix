# ═══════════════════════════════════════════════════════════════
#  .gitignore — Huntix
#  TUTTI i segreti devono essere in keystore.properties
#  e questo file garantisce che non finiscano su Git.
# ═══════════════════════════════════════════════════════════════

# ── SEGRETI (MAI su Git) ─────────────────────────────────────
keystore.properties
*.jks
*.keystore
.env

# Firebase config (contiene chiavi progetto)
app/google-services.json
google-services.json

# ── Build outputs (tutto rigenerabile) ────────────────────────
/build
/app/build
/huntix/build
/unityLibrary/build
*.apk
*.aab
*.dex
*.class

# ── Unity Library cache (3.8GB, rigenerato ad ogni apertura) ──
unity-project/Library/
unity-project/Temp/
unity-project/Logs/
unity-project/obj/
unity-project/UserSettings/

# ── Unity export gradle (4.5GB, rigenerato da build_release.sh) ─
unity-export.gradle/
unity-export/

# ── Unity backup files ───────────────────────────────────────
*.bak
*.bak2
unity-project/Assets/**/*.bak
unity-project/Assets/**/*.bak2
!unity-project/Assets/**

# ── Android Studio / IDE ──────────────────────────────────────
/.idea
*.iml
.DS_Store
/local.properties
*.log
*.hprof

# ── Gradle cache ──────────────────────────────────────────────
.gradle/
gradle-app.setting

# ── OS files ──────────────────────────────────────────────────
Thumbs.db
Desktop.ini

# ── Backend Huntix (Real Life) ───────────────────────────────
backend/venv/
backend/.env
backend/__pycache__/
backend/**/__pycache__/
*.pyc
backend/*.db
backend/nohup.out
backend/.env.example
backend/.hf_token
backend/.gen_status.json
backend/static/

# ── Licenza Unity: dipendenze di automazione e log ─────────────
unitylic/tools/node_modules/
unitylic/unity-license-check.log
unitylic/unity-export.log

# ── Unity AAR: rigenerata dalla build ──────────────────────────
*.aar

# ── ZIP kit (sorgenti, ma sono grandi) ─────────────────────────
kit/*.zip
kit/sketchfab/
kit/quaternius/
kit/extract/

# ── Preprocessing OSM: dati pesanti rigenerabili (3.6GB) ──────
backend/preprocessing/data/
backend/preprocessing/tiles/
backend/preprocessing/venv/
backend/preprocessing/work/
backend/preprocessing/srtm/
backend/preprocessing/dem_cache/
__pycache__/
*.pyc
*.pid

# ── Stati runtime dei servizi veicoli ─────────────────────────
backend/traffic/vehicles_state.json
backend/traffic/garages_state.json

# ── Backup con suffisso (es. .bak_compra, .bak_rp) ────────────
*.bak_*

# ── Kit grezzi estratti (già copiati dentro Assets; tengono solo il progetto) ─
kit/player/
kit/afterlife/

# ── Crash dump Unity (rumore, non codice) ─────────────────────
unity-project/mono_crash.*
unity-project/*.blob
