<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toast_creatura_schiuso3"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:background="#DAAA"
    android:paddingLeft="10dp"
    android:paddingRight="10dp">

    <ImageView
        android:id="@+id/imgCreatura"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="15dp"
        android:src="@drawable/creatura_69" />

    <ImageView
        android:id="@+id/imgCreatura2"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="15dp"
        android:layout_toEndOf="@+id/imgCreatura"
        android:src="@drawable/creatura_69" />

    <ImageView
        android:id="@+id/imgCreatura3"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="15dp"
        android:layout_toEndOf="@+id/imgCreatura2"
        android:src="@drawable/creatura_69" />

    <TextView
        android:id="@+id/txtCreatura"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/imgCreatura"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:textColor="#FFF"
        android:textSize="15dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txtCreatura"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="0dp"
        android:text="sono schiusi!"
        android:textColor="#FFF"
        android:textSize="15dp"
        android:textStyle="bold" />

</RelativeLayout>
