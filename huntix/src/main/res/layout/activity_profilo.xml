<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.intelligame.huntix.legacy.Controller.ProfiloActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/view_fundo_barra_navegacao"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:id="@+id/barraIndietroProfilo">

        <ImageButton
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_margin="5dp"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_action_back"
            android:background="@android:color/transparent"
            android:id="@+id/indietroProfilo"
            android:onClick="clickIndietro"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:text="Profilo dell’Utente"
            android:textStyle="normal"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="10dp"
            android:id="@+id/txtTitoloProfiloUser"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/indietroProfilo" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/barraIndietroProfilo">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="2dp"
                android:layout_centerHorizontal="true"
                android:text="nome dell’utente"
                android:textStyle="bold"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:id="@+id/txtNomeAllenatoreProfilo"/>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="200dp"
                android:layout_height="50dp"
                android:layout_alignParentTop="true"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="2dp"
                android:layout_centerHorizontal="true"
                android:indeterminate="false"
                android:max="100"
                android:progress="1" />

            <TextView
                android:id="@+id/txtLivello"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Livello 40"
                android:layout_marginTop="35dp"
                android:layout_marginBottom="2dp"
                android:layout_marginLeft="20dp"
                android:layout_alignParentLeft="true" />

            <TextView
                android:id="@+id/txtXp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/1000"
                android:layout_marginTop="35dp"
                android:layout_marginBottom="2dp"
                android:layout_marginRight="10dp"
                android:layout_alignParentRight="true" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="280dp"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:layout_marginBottom="5dp"
                android:layout_marginTop="10dp"
                android:id="@+id/imgAllenatoreProfilo"
                android:layout_below="@+id/txtNomeAllenatoreProfilo"
                android:layout_centerHorizontal="true"
                android:src="@drawable/male_grande"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/labelInicioAventuraProfilo"
                android:layout_below="@+id/imgAllenatoreProfilo"
                android:layout_centerHorizontal="true"
                android:text="Inizio dell’Avventura:"
                android:textStyle="bold"
                android:textColor="#000000"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/txtInicioAventuraProfilo"
                android:layout_below="@+id/labelInicioAventuraProfilo"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="5dp"
                android:text="25/12/2016 - 20:10:26"
                android:textStyle="italic"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/labelNumCattureProfilo"
                android:layout_below="@+id/txtInicioAventuraProfilo"
                android:layout_centerHorizontal="true"
                android:text="Numero di catture:"
                android:textStyle="bold"
                android:textColor="#000000"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/txtNumCattureProfilo"
                android:layout_below="@+id/labelNumCattureProfilo"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="0dp"
                android:text="50"
                android:textStyle="italic"/>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:text="Scambiare Creatura"
                android:id="@+id/buttonScambio"
                android:background="@drawable/bottone_style"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_centerHorizontal="true"
                android:layout_below="@+id/txtNumCattureProfilo"
                android:onClick="clickScambio"/>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Logout"
                android:id="@+id/button"
                android:background="@drawable/bottone_style"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_centerHorizontal="true"
                android:layout_below="@+id/buttonScambio"
                android:onClick="clickLogout"/>

        </RelativeLayout>

    </ScrollView>


</RelativeLayout>
