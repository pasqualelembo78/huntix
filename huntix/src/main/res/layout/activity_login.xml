<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.intelligame.huntix.legacy.Controller.LoginActivity">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:id="@+id/imgFundoLogin"
        android:src="@drawable/huntix_sfondo"
        android:alpha="0.9"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="30dp"
        android:background="@drawable/roundshapebranco"
        android:alpha="0.8"
        android:id="@+id/layoutFundoLogin">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Utente:"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_alignParentTop="true"
            android:layout_marginTop="25dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:id="@+id/labelUtenteLogin"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/labelUtenteLogin"
            android:layout_alignLeft="@+id/labelUtenteLogin"
            android:layout_alignRight="@+id/labelUtenteLogin"
            android:layout_marginTop="5dp"
            android:imeOptions="actionNext"
            android:singleLine="true"
            android:id="@+id/edtUtenteLogin"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password:"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_below="@+id/edtUtenteLogin"
            android:layout_alignLeft="@+id/edtUtenteLogin"
            android:layout_alignRight="@+id/edtUtenteLogin"
            android:layout_marginTop="15dp"
            android:id="@+id/labelPasswordLogin"/>

        <EditText
            android:password="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/labelPasswordLogin"
            android:layout_alignLeft="@+id/labelPasswordLogin"
            android:layout_alignRight="@+id/labelPasswordLogin"
            android:layout_marginTop="5dp"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:id="@+id/edtPasswordLogin"
            android:text=""/>

        <Button
            style="?android:attr/buttonStyleSmall"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Login"
            android:id="@+id/btnLogin"
            android:layout_below="@+id/edtPasswordLogin"
            android:layout_alignRight="@+id/edtPasswordLogin"
            android:layout_marginTop="15dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bottone_style"
            android:onClick="clickLogin"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrare"
            android:textColor="#992416"
            android:textStyle="bold"
            android:id="@+id/btnRegistrare"
            android:layout_below="@+id/btnLogin"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="25dp"
            android:onClick="clickRegistrare"/>

    </RelativeLayout>
</FrameLayout>
