<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.intelligame.huntix.legacy.Controller.RegistrareActivity">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:id="@+id/imgFundoRegistrazione"
        android:src="@drawable/huntix_sfondo"
        android:alpha="0.9"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/view_fundo_barra_navegacao"
        android:layout_gravity="top"
        android:id="@+id/barraIndietroRegistrare">

        <ImageButton
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_margin="5dp"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_action_back"
            android:background="@android:color/transparent"
            android:id="@+id/indietroRegistrare"
            android:onClick="clickIndietro"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:text="Registrare"
            android:textStyle="normal"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="10dp"
            android:id="@+id/txtTitoloRegistrare"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/indietroRegistrare" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="40dp"
        android:background="@drawable/roundshapebranco"
        android:alpha="0.8"
        android:id="@+id/layoutFundoRegistrazione">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome:"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_alignParentTop="true"
            android:layout_marginTop="25dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:id="@+id/labelNomeRegistrazione"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/labelNomeRegistrazione"
            android:layout_alignLeft="@+id/labelNomeRegistrazione"
            android:layout_alignRight="@+id/labelNomeRegistrazione"
            android:layout_marginTop="5dp"
            android:inputType="textCapSentences"
            android:id="@+id/edtNomeRegistrazione"
            android:text=""
            android:imeOptions="actionNext"
            android:singleLine="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Utente:"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_below="@+id/edtNomeRegistrazione"
            android:layout_alignLeft="@+id/edtNomeRegistrazione"
            android:layout_alignRight="@+id/edtNomeRegistrazione"
            android:layout_marginTop="5dp"
            android:id="@+id/labelUtenteRegistrazione"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/labelUtenteRegistrazione"
            android:layout_alignLeft="@+id/labelUtenteRegistrazione"
            android:layout_alignRight="@+id/labelUtenteRegistrazione"
            android:layout_marginTop="5dp"
            android:id="@+id/edtUtenteRegistrazione"
            android:imeOptions="actionNext"
            android:singleLine="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password:"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_below="@+id/edtUtenteRegistrazione"
            android:layout_alignLeft="@+id/edtUtenteRegistrazione"
            android:layout_alignRight="@+id/edtUtenteRegistrazione"
            android:layout_marginTop="5dp"
            android:id="@+id/labelPasswordRegistrazione"/>

        <EditText
            android:password="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/labelPasswordRegistrazione"
            android:layout_alignLeft="@+id/labelPasswordRegistrazione"
            android:layout_alignRight="@+id/labelPasswordRegistrazione"
            android:layout_marginTop="5dp"
            android:id="@+id/edtPasswordRegistrazione"
            android:text=""
            android:imeOptions="actionNext"
            android:singleLine="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conferma password:"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_below="@+id/edtPasswordRegistrazione"
            android:layout_alignLeft="@+id/edtPasswordRegistrazione"
            android:layout_alignRight="@+id/edtPasswordRegistrazione"
            android:layout_marginTop="5dp"
            android:id="@+id/labelConfirmacaoPasswordRegistrazione"/>

        <EditText
            android:password="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/labelConfirmacaoPasswordRegistrazione"
            android:layout_alignLeft="@+id/labelConfirmacaoPasswordRegistrazione"
            android:layout_alignRight="@+id/labelConfirmacaoPasswordRegistrazione"
            android:layout_marginTop="5dp"
            android:id="@+id/edtConfirmacaoPasswordRegistrazione"
            android:text=""
            android:imeOptions="actionDone"
            android:singleLine="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sesso:"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/edtConfirmacaoPasswordRegistrazione"
            android:layout_alignLeft="@+id/edtConfirmacaoPasswordRegistrazione"
            android:id="@+id/labelSesso"/>

        <RadioGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/grupoSesso"
            android:layout_below="@+id/labelSesso"
            android:layout_alignLeft="@+id/labelSesso"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="25dp">

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/sessoMaschile"
                android:text="Maschile"
                android:checked="true"/>

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/sessoFemminile"
                android:text="Femminile"/>

        </RadioGroup>

        <Button
            style="?android:attr/buttonStyleSmall"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_marginBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrare"
            android:id="@+id/btnLoginRegistrazione"
            android:layout_alignBottom="@+id/grupoSesso"
            android:layout_alignRight="@+id/edtConfirmacaoPasswordRegistrazione"
            android:layout_marginTop="15dp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bottone_style"
            android:onClick="clickRegistraUtente"/>

    </RelativeLayout>
</FrameLayout>
