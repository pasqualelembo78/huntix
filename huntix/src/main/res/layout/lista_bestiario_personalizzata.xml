<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    >

    <ImageView
        android:id="@+id/immagineCreaturaBestiario"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:layout_margin="10dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:src="@drawable/creatura_131_icona"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mostro Marino"
        android:textStyle="normal"
        android:textSize="20dp"
        android:textColor="#000000"
        android:layout_marginLeft="20dp"
        android:id="@+id/txtNomeCreaturaBestiario"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@+id/immagineCreaturaBestiario" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="#131"
        android:textStyle="normal"
        android:textSize="20dp"
        android:textColor="#808080"
        android:layout_marginRight="20dp"
        android:id="@+id/txtNumeroCreaturaBestiario"
        android:layout_centerVertical="true"
        android:layout_alignParentRight="true" />

</RelativeLayout>