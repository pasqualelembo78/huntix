<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- QR salvataggio in Immagini — necessario solo su Android 9 e precedenti -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- GPS — richiesto per modalità Outdoor -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ✅ FIX v7.2.1: VIBRATE — richiesto da AR minigames (haptic feedback) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Step counter for termoculla distance tracking -->
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepdetector" android:required="false" />
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="true" />
    <!-- Depth API: opzionale — funziona anche senza sensore ToF fisico (ML depth estimation) -->
    <uses-feature android:name="com.google.ar.core.depth" android:required="false" />

    <application
        android:allowBackup="false"
        android:name=".EggHuntApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.ARProto">

        <!-- Sentry DSN — da keystore.properties (non hardcodato) -->
        <meta-data
            android:name="io.sentry.dsn"
            android:value="${sentryDsn}"/>

        <!-- Sentry: abilita cattura ANR (Application Not Responding) -->
        <meta-data
            android:name="io.sentry.anr.enable"
            android:value="true" />

        <!-- Sentry: soglia ANR (ms prima di segnalare un blocco, default 5000) -->
        <meta-data
            android:name="io.sentry.anr.timeout-interval-mills"
            android:value="5000" />

        <!-- Sentry: allega screenshot al crash -->
        <!-- ✅ FIX v7.2: Disabilitato per protezione minori (COPPA) -->
        <meta-data
            android:name="io.sentry.attach-screenshot"
            android:value="false" />

        <!-- Sentry: allega gerarchia delle View al crash -->
        <meta-data
            android:name="io.sentry.attach-view-hierarchy"
            android:value="true" />

        <!-- Sentry: traccia performance UI (frame lenti) -->
        <meta-data
            android:name="io.sentry.traces.sample-rate"
            android:value="0.1" />

        <!-- Sentry: campionamento profiling (CPU) — 5% in produzione -->
        <meta-data
            android:name="io.sentry.traces.profiling.sample-rate"
            android:value="0.05" />

        <!-- AdMob App ID — da keystore.properties (non hardcodato) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}"/>
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" tools:replace="android:value"/>



        <!-- ARCore Cloud Anchor API Key (da ARCORE_API_KEY / local.properties).
             Se la key è vuota, un task Gradle rimuove questa <meta-data> così
             ARCore usa la keyless authorization (OAuth client ID Android:
             package + SHA-1) che sblocca TTL Cloud Anchor fino a 365gg. -->
        <meta-data
            android:name="com.google.android.ar.API_KEY"
            android:value="${arcoreApiKey}"/>

